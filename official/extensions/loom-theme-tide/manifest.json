{
  "manifestVersion": 2,
  "id": "loom-theme-tide",
  "version": "1.0.0",
  "displayName": "潮汐夜色",
  "author": "Loom Studio",
  "engines": {
    "studio": "^0.1.0"
  },
  "modules": [],
  "contributes": {
    "themes": [
      {
        "id": "tide",
        "label": "潮汐",
        "css": "./tide.css",
        "parameters": [
          {
            "id": "radius",
            "label": "输入框圆角",
            "variable": "--extension-tide-radius",
            "type": "number",
            "default": 12,
            "min": 0,
            "max": 24,
            "unit": "px"
          }
        ]
      }
    ],
    "styles": [
      {
        "id": "mint",
        "label": "薄荷强调色",
        "css": "./mint.css"
      },
      {
        "id": "amber",
        "label": "琥珀强调色",
        "css": "./amber.css"
      }
    ]
  }
}
