{
  "manifestVersion": 2,
  "id": "loom-theme-paper",
  "version": "1.0.1",
  "displayName": "纸页与轻动效",
  "description": "纯 CSS 羊皮纸主题，以及可独立采用、可选授权 JavaScript 的面板动效样例。",
  "author": "Loom Studio",
  "engines": { "studio": "^0.1.0" },
  "modules": [{ "id": "motion", "runtime": "client", "entry": "./client.js" }],
  "contributes": {
    "themes": [{
      "id": "paper",
      "label": "纸页",
      "description": "暖色叙事画布、包内纹理与设置图标，不需要运行代码。",
      "css": "./paper.css",
      "nativeMotion": "retain",
      "parameters": [
        { "id": "canvas-width", "label": "正文画布宽度", "variable": "--loom-canvas-width", "type": "number", "default": 760, "min": 540, "max": 1120, "step": 20, "unit": "px" },
        { "id": "blur", "label": "面板模糊", "variable": "--loom-preview-blur", "type": "number", "default": 12, "min": 0, "max": 32, "step": 1, "unit": "px" },
        { "id": "texture", "label": "纸张纹理强度", "variable": "--extension-paper-texture", "type": "number", "default": 0.5, "min": 0, "max": 1, "step": 0.05 }
      ]
    }],
    "styles": [{
      "id": "smooth-motion",
      "label": "轻动效",
      "description": "替换原生装饰动效；CSS 模式提供按钮反馈，授权代码后增加面板进入与退出动画。",
      "css": "./motion.css",
      "moduleId": "motion",
      "supportsCssOnly": true,
      "nativeMotion": "disable"
    }]
  }
}
